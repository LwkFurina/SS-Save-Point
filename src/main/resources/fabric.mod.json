{
	"schemaVersion": 1,
	"id": "ss-save-point",
	"version": "${version}",
	"name": "SS-Save-Point",
	"description": "Press F2 once, and you can choose a folder where your future and past screenshots will be automatically saved.",
	"authors": [
		"LwkFurina"
	],
	"contact": {
		"homepage": "https://github.com/LwkFurina/SS-Save-Point",
		"sources": "https://www.curseforge.com/minecraft/mc-mods/ss-save-point",
		"issues": "https://github.com/LwkFurina/SS-Save-Point/issues"
	},
	"license": "MIT",
	"icon": "assets/ss-save-point/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"lwkfurina.sssavepoint.SSSavePoint"
		],
		"client": [
			"lwkfurina.sssavepoint.client.SSSavePointClient"
		]
	},
	"mixins": [
		"ss-save-point.mixins.json",
		{
			"config": "ss-save-point.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}